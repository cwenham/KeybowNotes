{
  "version": 2,

  "defaults": {
    "colour": "202020",
    "commitDelayMs": 1000,
    "idleTimeoutMs": 10000,
    "longPressCancelMs": 1500,
    "dates": { "todayOffsetMinutes": 30, "defaultTime": "09:00" }
  },

  "contacts": {
    "Alex Example": { "phone": "+15550100", "email": "alex@example.com" }
  },

  "projects": {
    "Website": { "path": "~/Code/website" },
    "Firmware": { "path": "~/Code/firmware" }
  },

  "lists": {
    "when": [
      { "label": "Today", "params": { "when": "today" } },
      { "label": "Tomorrow", "params": { "when": "tomorrow" } },
      { "label": "Next week", "params": { "when": "next week" } },
      { "label": "Next month", "params": { "when": "next month" } }
    ]
  },

  "trees": {
    "main": [
      {
        "label": "Work",
        "colour": "0060ff",
        "children": [
          {
            "label": "Code",
            "children": [
              { "label": "Website", "action": { "type": "app.open", "app": "Visual Studio Code", "bundleId": "com.microsoft.VSCode" } },
              { "label": "Firmware", "action": { "type": "app.open", "app": "Thonny" } }
            ]
          },
          {
            "label": "Schedule",
            "action": { "type": "calendar.createEvent" },
            "children": [
              { "label": "Meeting", "action": { "alertMinutes": 5 }, "children": "@when" },
              { "label": "Deployment", "action": { "alertMinutes": 20 }, "children": "@when" }
            ]
          },
          {
            "label": "Contact",
            "children": [
              { "label": "Message", "action": { "type": "messages.compose" }, "children": [ { "label": "Alex Example" } ] },
              { "label": "Mail", "action": { "type": "mail.compose" }, "children": [ { "label": "Alex Example" } ] }
            ]
          },
          {
            "label": "Docs",
            "action": { "type": "notes.append", "template": "templates/project-entry.md" },
            "children": [
              { "label": "New project", "action": { "type": "notes.create", "template": "templates/new-project.md" } },
              { "label": "Website" },
              { "label": "Firmware" }
            ]
          }
        ]
      },
      {
        "label": "Home",
        "colour": "00c060",
        "children": [
          {
            "label": "Groceries",
            "action": { "type": "reminders.create", "list": "Shopping" },
            "children": [ { "label": "Milk" }, { "label": "Bread" }, { "label": "Eggs" }, { "label": "Coffee" } ]
          },
          { "label": "Appointment", "action": { "type": "calendar.createEvent" }, "children": "@when" }
        ]
      },
      {
        "label": "Writing",
        "colour": "ff8c00",
        "children": [
          { "label": "Characters", "children": [ { "label": "The Detective" }, { "label": "The Witness" } ] },
          { "label": "Scenes" }
        ]
      },
      {
        "label": "Ideas",
        "colour": "b060ff",
        "children": [ { "label": "Inventions" }, { "label": "Stories" }, { "label": "Wild speculation" } ]
      }
    ],

    "bottom": [
      {
        "label": "Journal",
        "colour": "ff5050",
        "action": { "type": "notes.append", "find": { "byName": "Journal — {{date:MMMM yyyy}}" }, "folder": "Journal" }
      }
    ]
  }
}
