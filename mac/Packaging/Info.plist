<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: build-app.sh fills in __BUNDLE_ID__, __VERSION__ and __BUILD__. -->
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>KeybowNotes</string>
	<key>CFBundleDisplayName</key>
	<string>KeybowNotes</string>
	<key>CFBundleIdentifier</key>
	<string>__BUNDLE_ID__</string>
	<key>CFBundleExecutable</key>
	<string>KeybowNotes</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<!-- A menu-bar app: no Dock icon, never takes focus from what you're doing. -->
	<key>LSUIElement</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Christopher Wenham</string>

	<!-- Shown in the macOS permission prompts. There is deliberately no
	     write-only calendar description: offering "add events only" would let
	     people choose an access level KeybowNotes can't work with, since it
	     finds calendars by name and opens the new event afterwards. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>KeybowNotes creates notes, reminders, events and email drafts when you choose them on the Keybow.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>KeybowNotes adds the events you choose on the Keybow, and opens them for editing.</string>
	<key>NSContactsUsageDescription</key>
	<string>KeybowNotes looks people up in Contacts when you add them to a tree, to fill in their number or address.</string>
	<key>NSLocationUsageDescription</key>
	<string>KeybowNotes puts where you are into the keys that ask for it — {{location}} in a note, or a weather source's address — and only when you press one.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>KeybowNotes puts where you are into the keys that ask for it — {{location}} in a note, or a weather source's address — and only when you press one.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>KeybowNotes adds the reminders and timers you choose on the Keybow.</string>
	<key>NSAppleScriptEnabled</key>
	<true/>
	<key>OSAScriptingDefinition</key>
	<string>KeybowNotes.sdef</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>KeybowNotes sets keypads up: it puts CircuitPython and its firmware on the keypad's drive.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>KeybowNotes talks to Home Assistant on your network, to switch lights and read sensors from your keys.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Home Assistant at home is usually plain http: at homeassistant.local,
		     which local networking allows with names without dots, or at a
		     private address, which needs its range named — a bare IP isn't
		     local networking to macOS. Plain http goes nowhere else. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>10.0.0.0/8</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>172.16.0.0/12</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>192.168.0.0/16</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>169.254.0.0/16</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>100.64.0.0/10</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>fc00::/7</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>fe80::/10</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
